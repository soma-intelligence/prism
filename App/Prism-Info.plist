<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>Soma.Prism.cloud-sync</string>
		<string>Soma.Prism.cloud-refresh</string>
		<string>Soma.Prism.widgets.refresh</string>
		<string>Soma.Prism.health-upload</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>With Always, your phone notes where it stays overnight so Soma can show where you sleep. Those places stay on this phone.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Soma.Prism</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>soma</string>
			</array>
		</dict>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>SomaSupabasePublishableKey</key>
	<string>$(SOMA_SUPABASE_PUBLISHABLE_KEY)</string>
	<key>SomaSupabaseURL</key>
	<string>$(SOMA_SUPABASE_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
</dict>
</plist>
